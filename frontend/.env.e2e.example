# Copy to .env.e2e (gitignored). All optional.
# Real admin login for e2e; without these the setup mints a dev token from JWT_SECRET.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Existing admin user id used by the minted dev token (default 1)
E2E_ADMIN_ID=
# Override server URLs (default http://localhost:3000 / http://localhost:3001)
E2E_BASE_URL=
E2E_API_URL=
